# Leave DRY_RUN unset (or true) for test mode: nothing is sent, payments are simulated.
DRY_RUN=true
PORT=8787
PUBLIC_URL=http://localhost:8787
ADMIN_TOKEN=change-me
# Encrypts each seller's payment keys. Keep it secret and never change it once sellers have connected.
APP_SECRET=

# Postgres. Unset = embedded Postgres stored in DATA_DIR (default ./.data).
DATABASE_URL=
DATA_DIR=./.data

# Oja's own WhatsApp number (Cloud API phone number id) that sends sellers their sign-in codes.
PLATFORM_WA_PHONE_ID=
WA_TEMPLATE_LOGIN=login_code_v1
WA_TEMPLATE_LOGIN_LANG=en

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API setup)
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_API_VERSION=v21.0
WA_TEMPLATE_HOLD=restock_hold_v1
WA_TEMPLATE_RACE=restock_race_v1
WA_TEMPLATE_SOLD_OUT=restock_sold_out_v1
WA_TEMPLATE_PAID=payment_received_v1
WA_TEMPLATE_REFUND=payment_refund_v1

# Some payment providers need an email per payment; buyers without one get <whatsapp number>@this domain.
BUYER_EMAIL_DOMAIN=buyers.yourdomain.com

# Estimated USD per free-form reply. Meta starts charging these beyond 1,000 a month from 1 Oct 2026.
RATE_SERVICE_USD=0

# Only for `npm run check:flutterwave` on your own machine. Use a TEST key.
FLW_SECRET_KEY=
