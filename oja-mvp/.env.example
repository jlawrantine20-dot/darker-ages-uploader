# Leave DRY_RUN unset (or true) to run with nothing sent and no real payments.
DRY_RUN=true
PORT=8787
PUBLIC_URL=http://localhost:8787
ADMIN_TOKEN=change-me

# Postgres. Unset = embedded Postgres stored in DATA_DIR (default ./.data).
# Supabase: Project settings > Database > Connection string (use the pooler URI).
DATABASE_URL=
DATA_DIR=./.data
TIMEZONE=Africa/Lagos

# WhatsApp Cloud API (developers.facebook.com > your app > WhatsApp > API setup)
WA_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=pick-any-long-random-string
WA_API_VERSION=v21.0
WA_TEMPLATE_LANG=en
WA_TEMPLATE_HOLD=restock_hold_v1
WA_TEMPLATE_RACE=restock_race_v1
WA_TEMPLATE_SOLD_OUT=restock_sold_out_v1
WA_TEMPLATE_PAID=payment_received_v1
WA_TEMPLATE_REFUND=payment_refund_v1

# Paystack (dashboard.paystack.com > Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=
PAYSTACK_CALLBACK_URL=
PAYSTACK_EMAIL_DOMAIN=buyers.yourdomain.ng

# Estimated Meta charge per message in kobo. Reported Nigeria rates from 1 Oct 2026;
# check Meta's current rate card and update.
RATE_SERVICE_KOBO=0
RATE_UTILITY_KOBO=1400
RATE_MARKETING_KOBO=8400
